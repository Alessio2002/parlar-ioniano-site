{
  "alphabet": [
    {
      "letter": "A",
      "ipa": ["[a]"]
    },
    {
      "letter": "B",
      "ipa": ["[b]"]
    },
    {
      "letter": "C",
      "rules": [
        { "condition": "Before i or e", "ipa": ["[t͡ʃ]"] },
        { "condition": "Otherwise", "ipa": ["[k]"] }
      ]
    },
    {
      "letter": "D",
      "ipa": ["[d]"]
    },
    {
      "letter": "E",
      "variants": [
        { "form": "E", "ipa": ["[e]"] },
        { "form": "È", "ipa": ["[ɛ]"] },
        { "form": "E (stressed)", "ipa": ["[ɛ]"] },
        { "form": "É (unstressed)", "ipa": ["[e]"] }
      ]
    },
    {
      "letter": "F",
      "ipa": ["[f]"]
    },
    {
      "letter": "G",
      "rules": [
        { "condition": "Before i or e", "ipa": ["[d͡ʒ]"] },
        { "condition": "Otherwise", "ipa": ["[g]"] }
      ]
    },
    {
      "letter": "H",
      "ipa": ["(Silent)"]
    },
    {
      "letter": "I",
      "ipa": ["[i]"]
    },
    {
      "letter": "J",
      "ipa": ["[j]"]
    },
    {
      "letter": "L",
      "ipa": ["[l]"]
    },
    {
      "letter": "M",
      "ipa": ["[m]"]
    },
    {
      "letter": "N",
      "ipa": ["[n]"]
    },
    {
      "letter": "O",
      "variants": [
        { "form": "O", "ipa": ["[o]"] },
        { "form": "Ò", "ipa": ["[ɔ]"] },
        { "form": "O (stressed)", "ipa": ["[ɔ]"] }
      ]
    },
    {
      "letter": "P",
      "ipa": ["[p]"]
    },
    {
      "letter": "Q",
      "rules": [
        { "condition": "Before i or e", "ipa": ["[k]"] },
        { "condition": "Qu + Vowel", "ipa": ["[kw]"] }
      ]
    },
    {
      "letter": "R",
      "variants": [
        { "form": "Default", "ipa": ["[r]", "(Rolled)"] },
        {
          "form": "Tapped",
          "condition": "Between vowels, after a consonant, or when previous word ends in a vowel",
          "ipa": ["[ɾ]"]
        }
      ]
    },
    {
      "letter": "S",
      "ipa": ["[s]"],
      "voicing_rules": {
        "voicing_contexts": [
          "between vowels",
          "before certain voiced consonants (b, d, g, m, n, v)"
        ],
        "voiced_ipa": "[z]",
        "exceptions": [
          "Does not shift to [z] if the vowel following is stressed",
          "Doubled <ss> stays geminated as [s.s]"
        ]
      }
    },
    {
      "letter": "T",
      "ipa": ["[t]"]
    },
    {
      "letter": "U",
      "rules": [
        { "condition": "Default", "ipa": ["[u]"] },
        { "condition": "Before a, e, i, or o", "ipa": ["[w]"] }
      ]
    },
    {
      "letter": "V",
      "ipa": ["[v]"]
    },
    {
      "letter": "X",
      "ipa": ["[ks]"]
    },
    {
      "letter": "Z",
      "ipa": ["[z]"]
    }
  ],
  "phonetics_overview": {
    "vowels": "A sound that results from not restricting air in the mouth during speech.",
    "consonants": "A sound that results from restriction of air in the mouth during speech."
  },
  "phonetic_features": [
    "When a word has a hard G, C or SC, it must keep the hard sound in all forms of the word."
  ],
  "diacritics_and_combinations": {
    "diacritics_overview": "Ionian features three diacritics: Grave, Acute, and Circumflex.",
    "specific_combinations": [
      { "pattern": "c + ì + vowel", "ipa": ["[t͡ʃj]"] },
      { "pattern": "c + í + vowel", "ipa": ["[t͡ʃˈi]"] },
      { "pattern": "g + ì + vowel", "ipa": ["[d͡ʒj]"] },
      { "pattern": "g + í + vowel", "ipa": ["[d͡ʒˈi]"] },
      { "pattern": "sc + ì + vowel", "ipa": ["[ʃj]"] },
      { "pattern": "sc + í + vowel", "ipa": ["[ʃˈi]"] },
      {
        "pattern": "û + i",
        "ipa": ["[ui̯]", "Does not carry stress of its own"]
      }
    ],
    "diacritic_usage_notes": [
      "Grave marker (`) distinguishes homonyms, marks stress position, and marks closed E [e] / O [o] versus open È [ɛ] / Ò [ɔ].",
      "É appears always as closed [e].",
      "Circumflex (^) distinguishes ûi /ui̯/ from ui /wi/."
    ],
    "palatal_vowel_combinations": [
      { "pattern": "ci + a / o / u", "ipa": ["[t͡ʃa] / [t͡ʃo] / [t͡ʃu]"] },
      { "pattern": "gi + a / o / u", "ipa": ["[d͡ʒa] / [d͡ʒo] / [d͡ʒu]"] },
      { "pattern": "sci + a / o / u", "ipa": ["[ʃa] / [ʃo] / [ʃu]"] }
    ],
    "extra_rules_c_g_sc": [
      { "pattern": "Qi / Qe", "ipa": ["[ki] / [ke]"] },
      { "pattern": "Ghi / Ghe", "ipa": ["[gi] / [ge]"] },
      { "pattern": "Sqi / Sqe", "ipa": ["[ski] / [ske]"] },
      {
        "pattern": "Sc",
        "rules": [
          { "condition": "Before i or e", "ipa": ["[ʃ]"] },
          { "condition": "Otherwise", "ipa": ["[k]"] }
        ]
      }
    ]
  },
  "digraphs": [
    { "digraph": "ch", "ipa": ["[x]"] },
    { "digraph": "th", "ipa": ["[θ]"] },
    { "digraph": "zz (medial) / z’ (word final)", "ipa": ["[t͡s̺]"] },
    { "digraph": "nc (Before a, o, u) / nq (Before i, e)", "ipa": ["[ŋk]"] },
    { "digraph": "ng (Before a, o, u) / ngh (Before i, e)", "ipa": ["[ŋg]"] },
    { "digraph": "gn", "ipa": ["[ɲ]"] },
    {
      "digraph": "gl + ia, ie, i, io, iu",
      "ipa": ["[ʎa], [ʎe], [ʎi], [ʎo], [ʎu]"]
    },
    { "digraph": "ll", "ipa": ["[l.l]"] },
    {
      "digraph": "tî",
      "ipa": [
        "[t͡ʃi]",
        "Appears in Standard Ionian, Central, Dûilaghian and Flumian dialects."
      ]
    },
    {
      "digraph": "tê",
      "ipa": [
        "[t͡ʃe]",
        "Appears in Standard Ionian, Central, Dûilaghian and Flumian dialects."
      ]
    },
    {
      "digraph": "-ée",
      "ipa": [
        "[ˈi.e]",
        "Appears only in feminine -i ending nouns as an irregular plural ending."
      ]
    }
  ],
  "orthography_and_punctuation": {
    "capitalisation": {
      "rules": [
        "First letter of sentences, titles, names of people, places, and institutions are capitalised.",
        "The content of direct speeches and quotes inside typographical marks are capitalised.",
        "Names of countries are capitalised, but not the names of languages (e.g., Lo parla ioniano - He speaks Ionian)."
      ],
      "examples": [
        {
          "type": "direct_speech",
          "ionian": "L’aja dido, -Ajo a' star in Italia.",
          "translation": "He said, “I am staying in Italy”."
        }
      ]
    },
    "country_names_and_articles": {
      "rule": "Articles are also placed before country names if there are no prepositions preceding the name.",
      "examples": [
        { "phrase": "L'Ionia", "meaning": "The country of Ionia" },
        { "phrase": "La Gallia", "meaning": "The country of France" },
        {
          "phrase": "Ple + adjective + dil'Ionia",
          "meaning": "more (adjective) than Ionia"
        },
        { "phrase": "So in Gallia", "meaning": "I am in France" },
        { "phrase": "So di Gallia", "meaning": "I am from France" }
      ]
    },
    "punctuation": {
      "comma": {
        "usages": [
          "Listing items",
          "Setting off nonessential information",
          "Separating main and subordinate clauses",
          "Appears before the word 'però - but'",
          "Appears as a subclause after 'pl'aò - also / moreover' and 'tûitavia - however'",
          "Used to mark decimals"
        ]
      },
      "period": {
        "name": "Le punto",
        "usage": "Used for separating big numbers, such as 10.000, etc."
      }
    }
  }
}
