{
  "alphabet": [
    {
      "letter": "A",
      "ipa": ["[a]"]
    },
    {
      "letter": "B",
      "ipa": ["[b]"]
    },
    {
      "letter": "C",
      "rules": [
        { "condition": "before i or e", "ipa": ["[t͡ʃ]"] },
        { "condition": "otherwise", "ipa": ["[k]"] }
      ]
    },
    {
      "letter": "D",
      "ipa": ["[d]"]
    },
    {
      "letter": "E",
      "variants": [
        { "form": "E", "ipa": ["[e]"] },
        { "form": "È", "ipa": ["[ɛ]"] },
        { "form": "E (stressed)", "ipa": ["[ɛ]"] },
        { "form": "É (unstressed)", "ipa": ["[e]"] }
      ]
    },
    {
      "letter": "F",
      "ipa": ["[f]"]
    },
    {
      "letter": "G",
      "rules": [
        { "condition": "before i or e", "ipa": ["[d͡ʒ]"] },
        { "condition": "otherwise", "ipa": ["[g]"] }
      ]
    },
    {
      "letter": "H",
      "ipa": ["(silent)"]
    },
    {
      "letter": "I",
      "ipa": ["[i]"]
    },
    {
      "letter": "J",
      "ipa": ["[j]"]
    },
